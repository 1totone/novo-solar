  -2.121320344, 3.535533906, -1,!- X,Y,Z Vertex 3 {m}
  -2.121320344, 3.535533906, 2.5;!- X,Y,Z Vertex 4 {m}

BuildingSurface:Detailed,
  COBERTURA,                  !- Name
