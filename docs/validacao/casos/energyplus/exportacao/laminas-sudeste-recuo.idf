  4,                          !- Number of Vertices
  -0.848528137, -0.848528137, 1.5,!- X,Y,Z Vertex 1 {m}
  -0.848528137, -0.848528137, 0,!- X,Y,Z Vertex 2 {m}
  0, 0, 0,                    !- X,Y,Z Vertex 3 {m}
